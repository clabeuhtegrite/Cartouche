{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cartouche Installer",
  "version": "0.2.1",
  "identifier": "io.github.clabeuhtegrite.cartouche.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cartouche Installer",
        "width": 880,
        "height": 680,
        "minHeight": 520,
        "minWidth": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Installs Cartouche on an iPhone",
    "copyright": "Cartouche contributors; iloader by nab138 (MIT)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French"
        ]
      }
    }
  }
}
