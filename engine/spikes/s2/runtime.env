# What spike S2 runs under on iOS, in the simulator in CI and in Cartouche on
# the iPhone, with the SHA-256 of each download. Change them together, and
# check the simulator run (.github/workflows/spike-s2.yml) passes.

# CPython for iOS from BeeWare's Python-Apple-support: the release, and its
# iOS package, Python-$PYTHON_VERSION-iOS-support.<build>.tar.gz.
PYTHON_VERSION=3.13
PYTHON_SUPPORT=3.13-b18
PYTHON_SUPPORT_SHA256=d06acf2a9c7964a8689566353a0e707402eff822037de5e29ba0e16040f7047d

# Capstone, built for iOS from its sources on PyPI: the same version as
# "pip install capstone" on a Mac.
CAPSTONE_VERSION=5.0.7
CAPSTONE_SHA256=796bdd69b05fa124fc2aa2e74b9a0b3d4c4e7f3e02add5e583cf2f3bca282ede
