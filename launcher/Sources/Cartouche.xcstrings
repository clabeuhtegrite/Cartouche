    "lab.folder.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a folder that holds your game’s ExeFS folder, or its modules (main, subsdk0, sdk…), with mac.sha256, the list of the files your Mac’s build wrote. Cartouche copies the modules, then writes into this folder its report, its own list, iphone.sha256, and the rewriter’s log."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un dossier qui contient le dossier ExeFS de votre jeu, ou ses modules (main, subsdk0, sdk…), avec mac.sha256, la liste des fichiers écrits par la construction de votre Mac. Cartouche copie les modules, puis écrit dans ce dossier son rapport, sa propre liste, iphone.sha256, et le journal de la réécriture."
          }
        }
      }
    },
