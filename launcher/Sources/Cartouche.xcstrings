    "setup.appleID.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in once in the SideStore built into Cartouche: it takes the certificate iloader left for it, and renews Cartouche every week. SideStore has you connect LocalDevVPN, asks for your Apple ID, then brings you back here by itself."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous une fois dans le SideStore intégré à Cartouche : il prend le certificat qu’iloader lui a laissé, et renouvelle Cartouche chaque semaine. SideStore vous fait connecter LocalDevVPN, demande votre compte Apple, puis vous ramène ici tout seul."
          }
        }
      }
    },
