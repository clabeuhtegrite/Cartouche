    "app.needsIOS17" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche needs iOS 17 or later."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche nécessite iOS 17 ou une version ultérieure."
          }
        }
