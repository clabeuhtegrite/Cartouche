    "setting.note.picture" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill crops the game’s 16:9 picture to cover the screen. Health bars, subtitles or maps near the edges can be cut off. A full-screen picture without cropping needs a patch for each game."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplir recadre l’image 16:9 du jeu pour couvrir l’écran. Les jauges, sous-titres ou cartes près des bords peuvent être coupés. Une image plein écran sans recadrage demande un correctif pour chaque jeu."
          }
        }
      }
    },
