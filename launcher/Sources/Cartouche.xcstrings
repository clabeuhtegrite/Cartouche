        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplir recadre l’image 16:9 du jeu pour couvrir l’écran. Les jauges, sous-titres ou cartes près des bords peuvent être coupés. Une image plein écran sans recadrage demande un correctif pour chaque jeu."
          }
        }
      }
