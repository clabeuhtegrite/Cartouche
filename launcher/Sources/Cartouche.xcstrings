    "daily.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An automation in Shortcuts can renew Cartouche every night, with no computer. It runs Cartouche’s Refresh All Apps action, which does what Renew now does."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une automatisation de Raccourcis peut renouveler Cartouche chaque nuit, sans ordinateur. Elle lance l’action Refresh All Apps de Cartouche, qui fait comme Renouveler maintenant."
          }
        }
      }
    },
    "daily.openShortcuts" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Shortcuts"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir Raccourcis"
          }
        }
      }
    },
    "daily.step1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave LocalDevVPN connected. Its traffic stays on the iPhone, so it can stay on all day."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez LocalDevVPN connecté. Son trafic reste sur l’iPhone : il peut rester activé toute la journée."
          }
        }
      }
    },
    "daily.step2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Shortcuts, open Automation, then tap +."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Raccourcis, ouvrez Automatisation, puis touchez +."
          }
        }
      }
    },
    "daily.step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Time of Day: a time when the iPhone charges and is online, such as 4 AM, every day. Then choose Run Immediately."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Heure de la journée : une heure où l’iPhone charge et a internet, par exemple 4 h, chaque jour. Puis choisissez Exécuter immédiatement."
          }
        }
      }
    },
    "daily.step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap Next, choose New Blank Automation, and add the Refresh All Apps action of Cartouche, not LiveContainer’s."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Suivant, choisissez Nouvelle automatisation vide, et ajoutez l’action Refresh All Apps de Cartouche, pas celle de LiveContainer."
          }
        }
      }
    },
    "daily.step5" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each renewal shows on the System page as the last renewal, and gives Cartouche seven more days."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque renouvellement s’affiche sur la page Système comme dernier renouvellement, et donne sept jours de plus à Cartouche."
          }
        }
      }
    },
