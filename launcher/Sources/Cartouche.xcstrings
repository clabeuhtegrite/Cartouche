    "lab.interrupted" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last rewrite did not finish: iOS closed Cartouche, perhaps for lack of memory. Its report, in the folder, gives the last memory reading."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dernière réécriture n’a pas fini : iOS a fermé Cartouche, peut-être faute de mémoire. Son rapport, dans le dossier, donne la dernière mesure de la mémoire."
          }
        }
      }
    },
    "lab.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche rewrites the code of your own game on this iPhone with nxnative’s rewriter, as your Mac does when it builds the game’s IPA, then compares each file with the one your Mac wrote. It also measures the time and the memory this takes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartouche réécrit le code de votre propre jeu sur cet iPhone avec la réécriture de nxnative, comme votre Mac quand il construit l’IPA du jeu, puis compare chaque fichier avec celui que votre Mac a écrit. Il mesure aussi le temps et la mémoire que cela prend."
          }
        }
      }
    },
