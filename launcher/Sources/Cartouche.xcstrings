    "signIn.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once on this iPhone. The SideStore built into Cartouche signs in with it without showing itself: it registers this iPhone with your account, takes the certificate the Cartouche Installer left for it, and renews Cartouche every week."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois sur cet iPhone. Le SideStore intégré à Cartouche s’en sert sans s’afficher : il inscrit cet iPhone sur votre compte, prend le certificat que l’Installeur Cartouche lui a laissé, et renouvelle Cartouche chaque semaine."
          }
        }
      }
    },
