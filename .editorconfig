root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.sh]
indent_size = 2

[*.patch]
trim_trailing_whitespace = false

# Licence texts stay as their projects wrote them.
[engine/spikes/s2/licenses/*.txt]
trim_trailing_whitespace = false
