{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devices.schema.json",
  "title": "Cartouche device profiles",
  "description": "Memory limits measured on real devices. The app also measures its own limit at run time; these entries say what testers saw.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "devices"],
  "properties": {
    "schema": { "const": 1 },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "chip", "memoryGB", "measurements"],
        "properties": {
          "identifier": { "type": "string", "pattern": "^(iPhone|iPad)[0-9]+,[0-9]+$" },
          "chip": { "type": "string", "minLength": 2, "maxLength": 20 },
          "memoryGB": { "type": "integer", "minimum": 1 },
          "measurements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "iOS", "increasedMemoryLimit", "appMemoryLimitMiB"],
              "properties": {
                "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "iOS": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+){0,2}$" },
                "increasedMemoryLimit": { "type": "boolean" },
                "appMemoryLimitMiB": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Footprint plus os_proc_available_memory(), the most an app may use before iOS ends it."
                }
              }
            }
          }
        }
      }
    }
  }
}
