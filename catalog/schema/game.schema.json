{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.schema.json",
  "title": "Cartouche game sheet",
  "description": "What a supported game needs, and how it ran on each iPhone it was tried on. A sheet never says where to get a game.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "titleId",
    "name",
    "platform",
    "requirements",
    "results"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "titleId": {
      "type": "string",
      "pattern": "^[0-9A-F]{16}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "platform": {
      "enum": [
        "switch",
        "switch2"
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumIOS",
        "bcTextureCompression",
        "increasedMemoryLimit"
      ],
      "properties": {
        "minimumIOS": {
          "$ref": "#/$defs/iosVersion"
        },
        "bcTextureCompression": {
          "type": "boolean",
          "description": "The GPU must sample BC-compressed textures (MTLDevice.supportsBCTextureCompression)."
        },
        "increasedMemoryLimit": {
          "type": "boolean",
          "description": "The game needs the Increased Memory Limit capability on Cartouche's App ID."
        },
        "peakMemoryMiB": {
          "type": "integer",
          "minimum": 1,
          "description": "Highest memory footprint measured on an iPhone while playing, with the engine of the latest result; the launcher compares it with the limit it measures on the phone. Left out until measured."
        }
      }
    },
    "recommended": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolution": {
          "enum": [
            "720p",
            "900p",
            "1080p"
          ]
        },
        "mode": {
          "enum": [
            "handheld",
            "docked"
          ]
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "iosVersion": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "iOS",
        "date",
        "engine",
        "status"
      ],
      "properties": {
        "device": {
          "type": "string",
          "pattern": "^(iPhone|iPad)[0-9]+,[0-9]+$"
        },
        "iOS": {
          "$ref": "#/$defs/iosVersion"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The nxnative build the result was measured with."
        },
        "status": {
          "enum": [
            "playable",
            "playable-with-issues",
            "boots",
            "does-not-run"
          ]
        },
        "peakMemoryMiB": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iPhones",
            "sessions",
            "from",
            "to",
            "endedBadlyPercent"
          ],
          "description": "Set on a result Cartouche's game measurements made, each week, from the sessions of the last 28 days on at least three iPhones of the model (telemetry/README.md#game-sheets); a tester's result has none. Each figure is the median of each iPhone's own, and left out when fewer than three iPhones measured it.",
          "properties": {
            "iPhones": {
              "type": "integer",
              "minimum": 3
            },
            "sessions": {
              "type": "integer",
              "minimum": 3
            },
            "from": {
              "$ref": "#/$defs/day"
            },
            "to": {
              "$ref": "#/$defs/day"
            },
            "fps": {
              "type": "number",
              "minimum": 0,
              "description": "The frame rate, weighted by time."
            },
            "slowestFps": {
              "type": "number",
              "minimum": 0,
              "description": "The frame rate of the slowest 5% of the time."
            },
            "targetFps": {
              "type": "integer",
              "minimum": 1,
              "description": "The frame rate the game asks for, that of most sessions."
            },
            "stuttersPerMinute": {
              "type": "number",
              "minimum": 0
            },
            "endedBadlyPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "The sessions that crashed, never drew a frame or ran out of memory, out of all of them."
            }
          }
        }
      }
    },
    "day": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
