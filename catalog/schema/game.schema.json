{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game.schema.json",
  "title": "Cartouche game sheet",
  "description": "What a supported game needs, and how it ran on each iPhone it was tried on. A sheet never says where to get a game.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "titleId",
    "name",
    "platform",
    "requirements",
    "results"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "titleId": {
      "type": "string",
      "pattern": "^[0-9A-F]{16}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "platform": {
      "enum": [
        "switch",
        "switch2"
      ]
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumIOS",
        "bcTextureCompression",
        "increasedMemoryLimit"
      ],
      "properties": {
        "minimumIOS": {
          "$ref": "#/$defs/iosVersion"
        },
        "bcTextureCompression": {
          "type": "boolean",
          "description": "The GPU must sample BC-compressed textures (MTLDevice.supportsBCTextureCompression)."
        },
        "increasedMemoryLimit": {
          "type": "boolean",
          "description": "The game needs the Increased Memory Limit capability on Cartouche's App ID."
        },
        "peakMemoryMiB": {
          "type": "integer",
          "minimum": 1,
          "description": "Highest memory footprint measured on an iPhone while playing, with the engine of the latest result; the launcher compares it with the limit it measures on the phone. Left out until measured."
        }
      }
    },
    "recommended": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolution": {
          "enum": [
            "720p",
            "900p",
            "1080p"
          ]
        },
        "mode": {
          "enum": [
            "handheld",
            "docked"
          ]
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "iosVersion": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,2}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "iOS",
        "date",
        "engine",
        "status"
      ],
      "properties": {
        "device": {
          "type": "string",
          "pattern": "^(iPhone|iPad)[0-9]+,[0-9]+$"
        },
        "iOS": {
          "$ref": "#/$defs/iosVersion"
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "The nxnative build the result was measured with."
        },
        "status": {
          "enum": [
            "playable",
            "playable-with-issues",
            "boots",
            "does-not-run"
          ]
        },
        "peakMemoryMiB": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    }
  }
}
