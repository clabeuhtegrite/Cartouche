#!/bin/bash
# The runner of Cartouche's CI on Ad's Mac (.github/mac/README.md), for Ad:
#
#     cartouche-ci              what it does now, and its last jobs
#     cartouche-ci pause        stops it now, until cartouche-ci resume
#     cartouche-ci resume
#     cartouche-ci logs         the supervisor's log and the runner's
#     cartouche-ci uninstall    removes it all, its account included
#
# install.sh puts it in /usr/local/bin. pause, resume, logs and uninstall
# ask for the Mac's password (sudo).

set -euo pipefail

SUPPORT=/Library/CartoucheCI
ACCOUNT=cartouche-ci

case "${1:-status}" in
  status)
    /usr/bin/python3 -I - "$SUPPORT/state.json" <<'PY'
import json, sys
try:
    state = json.load(open(sys.argv[1]))
except OSError:
    sys.exit("The runner's supervisor has not run yet: sudo launchctl kickstart system/fr.cartouche.ci.supervisor")
facts = state.get("facts", {})
running = state.get("runner") == "running"
print(f"Runner: {'online' if running else 'stopped'}{', a job runs now' if state.get('job') else ''} ({state.get('time')})")
print(f"Why: {state.get('why')}")
print(f"Power: {facts.get('power')}, {facts.get('free_gb', 0):.0f} GB free, paused: {'yes' if facts.get('paused') else 'no'}")
jobs = state.get("last_jobs") or []
print("Last jobs:" if jobs else "No job yet.")
for job in jobs:
    print(f"  {job}")
PY
    ;;
  pause)
    sudo touch "$SUPPORT/paused"
    sudo launchctl kickstart -k system/fr.cartouche.ci.supervisor
    echo "Paused: the runner stops now, and its jobs go to GitHub's Macs until cartouche-ci resume."
    ;;
  resume)
    sudo rm -f "$SUPPORT/paused"
    sudo launchctl kickstart -k system/fr.cartouche.ci.supervisor
    echo "Resumed: the runner starts again within a few seconds when the Mac is on mains power."
    ;;
  logs)
    sudo tail -n 40 /Library/Logs/CartoucheCI/supervisor.log "/Users/$ACCOUNT/logs/runner.log"
    ;;
  uninstall)
    read -r -p "Remove the runner, its account $ACCOUNT and all it built? [y/N] " answer </dev/tty
    case "$answer" in y|Y|yes|oui) ;; *) echo "Nothing removed."; exit 0 ;; esac
    homes="$(/usr/bin/python3 -I -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1])).get("homes", [])))' "$SUPPORT/config.json" 2>/dev/null || true)"
    sudo launchctl bootout system/fr.cartouche.ci.supervisor 2>/dev/null || true
    sudo launchctl bootout system/fr.cartouche.ci.runner 2>/dev/null || true
    # The ACL by which install.sh refused the account the other homes, before
    # the account goes: the ACL names it.
    while IFS= read -r home; do
      [ -n "$home" ] && [ -d "$home" ] || continue
      sudo chmod -a "user:$ACCOUNT deny list,search,add_file,add_subdirectory,delete_child,readattr,writeattr,readextattr,writeextattr,readsecurity,writesecurity,chown" "$home" 2>/dev/null || true
    done <<<"$homes"
    sudo dseditgroup -o edit -d "$ACCOUNT" -t user _developer 2>/dev/null || true
    sudo dscl . -delete "/Users/$ACCOUNT" 2>/dev/null || true
    sudo dscl . -delete "/Groups/$ACCOUNT" 2>/dev/null || true
    sudo rm -rf "/Users/$ACCOUNT" /Library/LaunchDaemons/fr.cartouche.ci.supervisor.plist \
      /Library/LaunchDaemons/fr.cartouche.ci.runner.plist /Library/Logs/CartoucheCI "$SUPPORT"
    sudo rm -f /usr/local/bin/cartouche-ci
    echo "Removed. GitHub forgets the runner ad-mac after 14 days offline, or at once in"
    echo "Settings › Actions › Runners. The simulators' iOS runtimes stay, for Xcode."
    ;;
  *)
    sed -n '2,11p' "$0" >&2
    exit 2
    ;;
esac
