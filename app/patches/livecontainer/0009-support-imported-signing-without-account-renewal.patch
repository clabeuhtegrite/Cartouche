 extern NSUserDefaults *lcUserDefaults;
 extern NSString *lcAppUrlScheme;
@@ -11,7 +12,57 @@
 NSString* FBSOpenApplicationOptionKeyActivateAsClassic = @"__ActivateAsClassic";
 NSString* FBSOpenApplicationOptionKeyPayloadURL = @"__PayloadURL";
 
+static NSDictionary *cartoucheSigningCandidate;
+static NSDictionary *cartoucheCachedSigningMaterial;
+
 @implementation LCSharedUtils
+
++ (BOOL)cartoucheUsesImportedSigning {
+    @synchronized(self) {
+        if (cartoucheSigningCandidate) return YES;
+    }
+    NSBundle *host = lcMainBundle ?: NSBundle.mainBundle;
+    NSUserDefaults *defaults = lcUserDefaults ?: NSUserDefaults.standardUserDefaults;
+    return [host.infoDictionary[@"CartoucheImportedSigning"] boolValue]
+        || [defaults boolForKey:@"Cartouche.importedSigning.selected"];
+}
+
++ (void)setCartoucheSigningCandidate:(NSDictionary *)material {
+    @synchronized(self) {
+        cartoucheSigningCandidate = [material copy];
+        cartoucheCachedSigningMaterial = nil;
+    }
+}
+
++ (NSDictionary *)cartoucheSigningMaterial {
+    @synchronized(self) {
+        if (cartoucheSigningCandidate) return cartoucheSigningCandidate;
+        if (![self cartoucheUsesImportedSigning]) return nil;
+        if (cartoucheCachedSigningMaterial) return cartoucheCachedSigningMaterial;
+        NSBundle *host = lcMainBundle ?: NSBundle.mainBundle;
+        NSString *service = host.infoDictionary[@"CartoucheBundleIdentifier"];
+        if (!service) return nil;
+        NSDictionary *query = @{
+            (__bridge id)kSecClass: (__bridge id)kSecClassGenericPassword,
+            (__bridge id)kSecAttrService: service,
+            (__bridge id)kSecAttrAccount: @"Cartouche.importedSigning.material",
+            (__bridge id)kSecReturnData: @YES,
+            (__bridge id)kSecMatchLimit: (__bridge id)kSecMatchLimitOne
+        };
+        CFTypeRef result = nil;
+        if (SecItemCopyMatching((__bridge CFDictionaryRef)query, &result) != errSecSuccess) return nil;
+        NSData *data = CFBridgingRelease(result);
+        id material = [NSPropertyListSerialization propertyListWithData:data options:NSPropertyListImmutable format:nil error:nil];
+        if (![material isKindOfClass:NSDictionary.class]
+            || ![material[@"certificate"] isKindOfClass:NSData.class]
+            || ![material[@"password"] isKindOfClass:NSString.class]) return nil;
+        // Cache before guest keychain hooks are installed. No secrets are
+        // written to preferences or shared files.
+        cartoucheCachedSigningMaterial = material;
+        return material;
+    }
+}
+
 
 + (NSString*) teamIdentifier {
     static NSString* ans = nil;
@@ -65,6 +116,12 @@
     static dispatch_once_t once;
     static NSString *appGroupID = @"Unknown";
     dispatch_once(&once, ^{
+        // Imported signing may have no app-group entitlement. With no
+        // extensions in this mode, the host and guest use the app's sandbox.
+        if ([NSBundle.mainBundle.infoDictionary[@"CartoucheImportedSigning"] boolValue]) {
+            appGroupID = NSBundle.mainBundle.bundleIdentifier;
+            return;
+        }
         NSArray* possibleAppGroups = @[
             [@"group.com.SideStore.SideStore." stringByAppendingString:[self teamIdentifier]]
         ];
@@ -129,11 +186,20 @@
     static dispatch_once_t onceToken;
     dispatch_once(&onceToken, ^{
         appGroupPath = [NSFileManager.defaultManager containerURLForSecurityApplicationGroupIdentifier:[LCSharedUtils appGroupID]];
+        if (!appGroupPath && [NSBundle.mainBundle.infoDictionary[@"CartoucheImportedSigning"] boolValue]) {
+            NSURL *support = [NSFileManager.defaultManager URLForDirectory:NSApplicationSupportDirectory
+                                                               inDomain:NSUserDomainMask
+                                                      appropriateForURL:nil create:YES error:nil];
+            appGroupPath = [support URLByAppendingPathComponent:@"CartoucheShared" isDirectory:YES];
+            [NSFileManager.defaultManager createDirectoryAtURL:appGroupPath
+                                  withIntermediateDirectories:YES attributes:nil error:nil];
+        }
     });
     return appGroupPath;
 }
 
 + (NSString *)certificatePassword {
+    if ([self cartoucheUsesImportedSigning]) return [self cartoucheSigningMaterial][@"password"];
     NSUserDefaults* nud = NSUserDefaults.lcSharedDefaults ?: NSUserDefaults.standardUserDefaults;
     return [nud objectForKey:@"LCCertificatePassword"];
 }
