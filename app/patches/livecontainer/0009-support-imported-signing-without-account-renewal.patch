From: Cartouche contributors
Subject: [PATCH] Support imported signing with keychain credentials and no account renewal

--- a/LiveContainer/LCSharedUtils.m
+++ b/LiveContainer/LCSharedUtils.m
@@ -3,6 +3,7 @@
 #import "UIKitPrivate.h"
 #import "utils.h"
 @import MachO;
