-                        Label(CartoucheText.gamesTab, systemImage: "gamecontroller.fill")
-                    }
-                    .tag(LCTabIdentifier.games)
-            }
-            LCAppListView()
-                .tabItem {
-                    Label("lc.tabView.apps".loc, systemImage: "square.stack.3d.up.fill")
-                }
-                .tag(LCTabIdentifier.apps)
-            if #available(iOS 17.0, *) {
-                CartoucheSystemView()
-                    .tabItem {
-                        Label(CartoucheText.systemTab, systemImage: "cpu")
-                    }
-                    .tag(LCTabIdentifier.system)
+                CartoucheRootView()
+            } else {
+                CartoucheNeedsNewerIOSView()
             }
-            
-            LCSettingsView()
-                .tabItem {
-                    Label("lc.tabView.settings".loc, systemImage: "gearshape.fill")
-                }
-                .tag(LCTabIdentifier.settings)
         }
         .downloadAlert(helper: downloadHelper)
         .environmentObject(downloadHelper)
@@ -117,38 +99,16 @@ struct LCTabView: View {
     }
     
     func dispatchURL(url: URL) {
-        repeat {
-            if url.isFileURL {
-                // Cartouche: a pairing file opened from AirDrop or Files goes
-                // to Cartouche's setup, not to the app installer.
-                if CartouchePairing.openedFile(url) {
-                    sharedModel.selectedTab = .initial
-                    return
-                }
-                sharedModel.selectedTab = .apps
-                break
-            }
-            if url.scheme?.lowercased() == "sidestore" {
-                sharedModel.selectedTab = .apps
-                break
-            }
-            
-            guard let host = url.host?.lowercased() else {
-                return
-            }
-            
-            switch host {
-            case "livecontainer-launch", "install", "open-web-page", "open-url":
-                sharedModel.selectedTab = .apps
-            case "certificate":
-                sharedModel.selectedTab = .settings
-            default:
-                return
-            }
-            
-        } while(false)
-
-        sharedModel.deepLink = url
+        // Cartouche: a link opens one of its screens or nothing. A pairing
+        // file or an IPA opened from AirDrop or Files goes to Cartouche,
+        // which checks the pairing file or installs the game itself. The
+        // links that led to LiveContainer's own pages, to install an app,
+        // open a web page, launch an app or take a certificate, are dropped:
+        // Cartouche downloads no app, starts its games itself and hands the
+        // built-in SideStore's certificate to LiveContainer on its own.
+        if url.isFileURL, CartouchePairing.openedFile(url) {
+            sharedModel.selectedTab = .initial
+        }
     }
     
     func closeDuplicatedWindow() {
