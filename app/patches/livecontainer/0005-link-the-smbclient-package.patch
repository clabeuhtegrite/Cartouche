+/* Begin XCSwiftPackageProductDependency section */
+		CA27C0DE2F5C000000000002 /* SMBClient */ = {
+			isa = XCSwiftPackageProductDependency;
+			package = CA27C0DE2F5C000000000001 /* XCLocalSwiftPackageReference "Packages/SMBClient" */;
+			productName = SMBClient;
+		};
+/* End XCSwiftPackageProductDependency section */
 	};
 	rootObject = 17DCE9952C7067EC00731D42 /* Project object */;
