 			productReference = 17413FB52D9C0BAE00F3F928 /* LiveContainerSwiftUI.framework */;
@@ -852,6 +855,7 @@
 			);
 			mainGroup = 17DCE9942C7067EC00731D42;
 			packageReferences = (
+				CA27C0DE2F5C000000000001 /* XCLocalSwiftPackageReference "Packages/SMBClient" */,
