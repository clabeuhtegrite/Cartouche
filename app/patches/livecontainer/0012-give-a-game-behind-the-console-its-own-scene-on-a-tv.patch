+#pragma mark - Cartouche: the app's scene on an external display
+
+// The scene SpringBoard gave an app for an external display before iOS 27,
+// whose role is UIWindowSceneSessionRoleExternalDisplayNonInteractive: the
+// app's UIKit asks its delegate for that role's configuration, and nxnative
+// answers with its TV scene (main.m, DmTVSceneDelegate). It is the
+// application scene's specification for an external screen, beside the
+// one this controller hosts the app's own scene with.
+- (UIViewController *)openExternalDisplaySceneOnScreen:(UIScreen *)screen {
+    [self closeExternalDisplayScene];
+    Class specificationClass = NSClassFromString(@"UIApplicationExternalScreenSceneSpecification");
+    if(!specificationClass || ![specificationClass isSubclassOfClass:UIApplicationSceneSpecification.class]
+       || !screen || !self.isAppRunning || !self.usesHostingControllerAPI) {
+        return nil;
+    }
+    RBSProcessPredicate* predicate = [PrivClass(RBSProcessPredicate) predicateMatchingIdentifier:@(self.pid)];
+    RBSProcessHandle* processHandle = [PrivClass(RBSProcessHandle) handleForPredicate:predicate error:nil];
+    if(!processHandle) {
+        return nil;
+    }
+    _UISceneHostingControllerAdvancedConfiguration *config = [[_UISceneHostingControllerAdvancedConfiguration alloc] initWithProcessIdentity:processHandle.identity];
+    config.sceneSpecification = [specificationClass specification];
+    // A scene of its own beside the app's, whatever identifier iOS would
+    // derive for a second scene of the same process.
+    if([config respondsToSelector:NSSelectorFromString(@"setSceneIdentifier:")]) {
+        [config setValue:[NSString stringWithFormat:@"sceneID:LiveProcess-%@-ExternalDisplay-%@", self.dataUUID, NSUUID.UUID.UUIDString]
+                  forKey:@"sceneIdentifier"];
+    }
+    _UISceneHostingController *hostingController = [[_UISceneHostingController alloc] initWithAdvancedConfiguration:config];
+    UIViewController *sceneViewController = hostingController.sceneViewController;
+    _UIScenePresenter *presenter = [sceneViewController.view valueForKey:@"_scenePresenter"];
+    if(!presenter.scene) {
+        [hostingController invalidate];
+        return nil;
+    }
+    CGRect bounds = screen.bounds;
+    NSString *persistenceIdentifier = [NSString stringWithFormat:@"%@-ExternalDisplay", self.dataUUID];
+    [presenter.scene configureParameters:^(FBSMutableSceneParameters *parameters) {
+        [parameters updateSettingsWithBlock:^(UIMutableApplicationSceneSettings *settings) {
+            settings.displayConfiguration = screen.displayConfiguration;
+            settings.frame = bounds;
+            settings.foreground = YES;
+            settings.level = 1;
+            settings.interfaceOrientation = UIInterfaceOrientationPortrait;
+            settings.deviceOrientation = UIDeviceOrientationPortrait;
+            settings.persistenceIdentifier = persistenceIdentifier;
+            settings.statusBarDisabled = YES;
+        }];
+        [parameters updateClientSettingsWithBlock:^(UIMutableApplicationSceneClientSettings *clientSettings) {
+            clientSettings.interfaceOrientation = UIInterfaceOrientationPortrait;
+        }];
+    }];
+    sceneViewController.view.clipsToBounds = YES;
+    self.externalDisplayHostingController = hostingController;
+    self.externalDisplayPresenter = presenter;
+    return sceneViewController;
+}
+
+- (void)setExternalDisplaySceneForeground:(BOOL)foreground {
+    [self.externalDisplayPresenter.scene updateSettingsWithBlock:^(UIMutableApplicationSceneSettings *settings) {
+        settings.foreground = foreground;
+        if(foreground) {
+            settings.deactivationReasons = 0;
+        }
+    }];
+}
+
+- (void)closeExternalDisplayScene {
+    if(@available(iOS 17.0, *)) {
+        _UISceneHostingController *hostingController = self.externalDisplayHostingController;
+        self.externalDisplayHostingController = nil;
+        self.externalDisplayPresenter = nil;
+        [hostingController invalidate];
+    }
+}
+
 @end
  
