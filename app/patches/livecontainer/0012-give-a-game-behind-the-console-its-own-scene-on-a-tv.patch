     func application(_ application: UIApplication, configurationForConnecting connectingSceneSession: UISceneSession, options: UIScene.ConnectionOptions) -> UISceneConfiguration {
+        // Cartouche: a TV that iOS 27 hands Cartouche for the scene accessory
+        // of a game behind the console shows Cartouche's TV screen, never
+        // LiveContainer's own scene (launcher/Sources/CartoucheTV.swift).
+        if #available(iOS 27.0, *), connectingSceneSession.role == .windowExternalDisplayNonInteractive {
+            let configuration = UISceneConfiguration(name: nil, sessionRole: connectingSceneSession.role)
+            configuration.delegateClass = CartoucheTVSceneDelegate.self
+            return configuration
+        }
         let configuration = UISceneConfiguration(name: nil, sessionRole: connectingSceneSession.role)
         configuration.delegateClass = SceneDelegate.self
         return configuration
