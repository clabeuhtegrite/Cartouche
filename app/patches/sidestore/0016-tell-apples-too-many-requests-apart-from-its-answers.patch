+// Cartouche: Apple's own page for an HTTP error, such as "429 Too Many
+// Requests" when it limits the sign-ins for now, is no answer to read: read
+// as one, it became "unparseable format" with the page's HTML for a message,
+// which the player saw as it was. Needs proper testing on an iPhone that
+// Apple limits.
+public extension ServerError {
+    /// The error an HTTP RESPONSE from Apple stands for before its BODY is
+    /// read, when Apple gave no answer of its own: 429, Too Many Requests,
+    /// whatever the body; or another status of error with a page (HTML) for
+    /// a body. Nil for any other response, which is read as before, with
+    /// the codes of Apple's own answers.
+    static func httpFailure(_ response: URLResponse?, body: Data) -> ServerError? {
+        guard let response = response as? HTTPURLResponse else { return nil }
+        let code = response.safeStatusCode
+        if code != HTTPStatusCodes.tooManyRequests {
+            guard !(200...299).contains(code), self.isPage(body, contentType: self.header("Content-Type", of: response)) else {
+                return nil
+            }
+        }
+        return .httpStatus(code: code, retryAfter: self.retryAfter(of: response), service: self.service(of: response.url))
+    }
+
+    /// Whether BODY is a page, as a web server sends for an error, rather
+    /// than a property list, JSON or Apple's buddyml.
+    static func isPage(_ body: Data, contentType: String?) -> Bool {
+        if contentType?.lowercased().contains("text/html") == true {
+            return true
+        }
+        let start = String(decoding: body.prefix(512), as: UTF8.self).lowercased()
+        return start.contains("<html") || start.contains("<!doctype html")
+    }
+
+    /// The seconds RESPONSE's Retry-After asks to wait, a week at most,
+    /// whether it gives them or a date.
+    static func retryAfter(of response: HTTPURLResponse) -> Int? {
+        guard let value = self.header("Retry-After", of: response)?.trimmingCharacters(in: .whitespaces), !value.isEmpty else {
+            return nil
+        }
+        let week = 7 * 86_400
+        if let seconds = Int(value) {
+            return seconds >= 0 ? min(seconds, week) : nil
+        }
+        let formatter = DateFormatter()
+        formatter.locale = Locale(identifier: "en_US_POSIX")
+        formatter.timeZone = TimeZone(identifier: "GMT")
+        formatter.dateFormat = "EEE, dd MMM yyyy HH:mm:ss zzz"
+        guard let date = formatter.date(from: value) else { return nil }
+        return min(max(0, Int(date.timeIntervalSinceNow.rounded(.up))), week)
+    }
+
+    /// Which of Apple's services URL is, as a name.
+    static func service(of url: URL?) -> String {
+        switch url?.host?.lowercased() {
+        case "gsa.apple.com": return "grandSlam"
+        case "developerservices2.apple.com": return "developerServices"
+        default: return "other"
+        }
+    }
+
+    private static func header(_ name: String, of response: HTTPURLResponse) -> String? {
+        for (key, value) in response.allHeaderFields {
+            if let key = key as? String, key.caseInsensitiveCompare(name) == .orderedSame {
+                return value as? String
+            }
+        }
+        return nil
+    }
+}
+
