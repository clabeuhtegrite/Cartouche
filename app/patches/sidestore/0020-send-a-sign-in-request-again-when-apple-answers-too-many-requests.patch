index 3b84691..d04a230 100644
--- a/Dependencies/SideSign/Sources/DeveloperPortal/Authentication.swift
+++ b/Dependencies/SideSign/Sources/DeveloperPortal/Authentication.swift
@@ -344,9 +344,15 @@ public extension DeveloperPortal {
             verboseLog("[SideSign] sendAuthenticationRequest HTTP headers: \(prettyJSONString(from: sanitizeHeadersForLogging(allHeaders)))")
         }
 
+        // Cartouche: sent again while Apple answers 429, as the Cartouche
+        // Installer does (GrandSlamResend).
         let (data, response): (Data, URLResponse)
         do {
-            (data, response) = try await session.data(for: request)
+            (data, response) = try await GrandSlamResend.sending(noting: { resend in
+                debugLog("[SideSign] Auth endpoint answered HTTP 429: sending the request again (\(resend) of \(GrandSlamResend.limit))")
+            }) {
+                try await session.data(for: request)
+            }
