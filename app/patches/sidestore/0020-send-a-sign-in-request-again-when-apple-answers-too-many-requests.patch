 .../DeveloperPortal/GrandSlamResend.swift     | 56 +++++++++++++++++++
 .../SignInOperation.swift                     |  7 ++-
 SideStore/Intents/CartoucheOutcome.swift      | 32 ++++++++++-
 4 files changed, 100 insertions(+), 3 deletions(-)
 create mode 100644 Dependencies/SideSign/Sources/DeveloperPortal/GrandSlamResend.swift

