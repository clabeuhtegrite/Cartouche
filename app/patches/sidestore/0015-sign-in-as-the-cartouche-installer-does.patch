+    /// The server's /v3/get_headers, and nothing else: every failure is
+    /// thrown. A GetHeadersError, the server refusing this adi.pb (-45061:
+    /// "reprovision required"), is a badServerResponse with status -1 and
+    /// the server's message.
+    private func getV3Headers(identifier: [UInt8], adiPb: [UInt8]) async throws -> AnisetteDataResponse {
+        let baseURL = serverURL.absoluteString.trimmingCharacters(in: CharacterSet(charactersIn: "/"))
+        guard !adiPb.isEmpty else {
+            throw AnisetteError.invalidAnisetteData
+        }
+        guard let url = URL(string: "\(baseURL)/\(Constants.URLs.v3GetHeaders)") else {
+            throw AnisetteError.invalidURL
+        }
+
+        var request = URLRequest(url: url)
+        request.timeoutInterval = Constants.Anisette.remoteRequestTimeout
+        request.httpMethod = "POST"
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.cachePolicy = .reloadIgnoringLocalCacheData
+        request.httpBody = try JSONSerialization.data(withJSONObject: [
+            "identifier": self.encoded(identifier),
+            "adi_pb": Data(adiPb).base64EncodedString()
+        ])
+
+        let (data, response) = try await URLSession.shared.data(for: request)
+        let status = (response as? HTTPURLResponse)?.statusCode ?? -1
+        guard let httpResp = response as? HTTPURLResponse, httpResp.isSuccess else {
+            // A server's error page says nothing more than its status.
+            throw AnisetteError.badServerResponse(statusCode: status, payload: "")
+        }
+        guard let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
+            throw AnisetteError.invalidAnisetteData
+        }
+        if let result = json["result"] as? String, result == "GetHeadersError" {
+            throw AnisetteError.badServerResponse(statusCode: -1, payload: json["message"] as? String ?? "GetHeadersError")
+        }
+        return try AnisetteDataResponse(from: json.compactMapValues { $0 as? String })
+    }
