+    /// Anisette from SERVER as the Cartouche Installer (isideload) gets it:
+    /// the identifier written in base64, the identity CLIENT INFO and USER
+    /// AGENT on every request, provisioning when there is no EXISTING ADI
+    /// BLOB, and no v1 headers of the server's own machine should
+    /// /v3/get_headers fail. Nothing is cached.
+    public func fetchStrictRemoteAnisetteData(
+        server: URL,
+        identifier: UUID,
+        existingAdiBlob: Data?,
+        clientInfo: String,
+        userAgent: String,
+        localUserID: String
+    ) async throws -> (data: AnisetteData, newAdiBlob: Data?) {
+        try FileManager.default.createDirectory(at: provisioningDir, withIntermediateDirectories: true)
+        let client = try AnisetteClient(
+            provisioningDir: provisioningDir,
+            clientInfo: clientInfo,
+            userAgent: userAgent,
+            lookupURL: Constants.Anisette.URLs.grandSlamLookup,
+            requiredLibraries: Constants.Anisette.Libraries.requiredNames,
+            provider: RemoteAnisetteDataProvider(serverURL: server, identifierEncoding: .base64, allowsV1Fallback: false)
+        )
+        let headers = AnisetteRequestHeaders().with {
+            $0.clientInfo = clientInfo
+            $0.userAgent = userAgent
+            $0.localUserID = localUserID
+        }
+        let (rawHeaders, newBlob) = try await client.getAnisetteData(
+            identifier: identifier,
+            storage: .memory(existingBlob: existingAdiBlob),
+            headers: headers
+        )
+        return (try Self.validateAndCreateAnisetteData(from: rawHeaders), newBlob)
+    }
+
