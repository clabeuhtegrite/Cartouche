+//
+//  CartoucheAnisette.swift
+//  SideStore
+//
+//  Cartouche: anisette as the Cartouche Installer (iloader, isideload) gets
+//  it, which Apple accepts. Since October 2026, Apple refuses a sign-in whose
+//  identity is not the kind of machine that made its anisette (-80045), and
+//  SideStore's own way mixed them: it says it is a Mac, but takes anisette
+//  from any server of its list, most of them Android ones, or makes it on the
+//  device, and keeps the machine one server made (an identifier and its
+//  adi.pb) for the next.
+//
+//  Here, a sign-in:
+//  - says it is the Mac the Cartouche Installer says it is
+//    (AppConstants.Anisette.Cartouche) on every request: provisioning,
+//    anisette, sign-in, verification code;
+//  - takes its anisette from the Cartouche Installer's Mac servers only, in
+//    its order, starting with the one that last worked;
+//  - writes the identifier as the v3 protocol has it (base64), and never
+//    takes a server's own v1 headers instead;
+//  - keeps the machine it made, in the keychain with what it was made with
+//    (Keychain.cartoucheAnisette), but makes a new one when the one there was
+//    made another way, when the server refuses it (-45061, "reprovision
+//    required": reinstalling did not help, since the keychain outlives the
+//    app), or when Apple refused the last sign-in with it, which then starts
+//    with the next server.
+//
+//  What follows such a sign-in (the developer services, renewals) keeps its
+//  machine and identity, since Apple's token works only with them. An account
+//  signed in before keeps SideStore's own way until it signs in again.
+//
+//  Needs proper testing on an iPhone, with each server.
+//
+
+import CryptoKit
+import Foundation
+import SideSign
+
+enum CartoucheAnisette
+{
+    /// What the identifier and adi.pb in the keychain were made with.
+    struct Binding: Codable, Equatable
+    {
+        var version: Int
+        /// The server that last gave anisette for them.
+        var server: String
+        var clientInfo: String
+        var userAgent: String
+        /// Whether Apple refused the last sign-in made with them.
+        var refused: Bool
+    }
+
+    private struct Machine
+    {
+        var identifier: UUID
+        var adiPb: Data
+    }
+
+    private static let version = 1
+
+    private static var binding: Binding? {
+        get {
+            guard let text = Keychain.shared.cartoucheAnisette,
+                  let binding = try? JSONDecoder().decode(Binding.self, from: Data(text.utf8)),
+                  binding.version == self.version
+            else { return nil }
+            return binding
+        }
+        set {
+            guard let newValue, let data = try? JSONEncoder().encode(newValue) else {
+                Keychain.shared.cartoucheAnisette = nil
+                return
+            }
+            Keychain.shared.cartoucheAnisette = String(decoding: data, as: UTF8.self)
+        }
+    }
+
+    /// Whether the machine in the keychain was made here: what follows a
+    /// sign-in keeps using it.
+    static var isBound: Bool { self.binding != nil }
+
+    static func fetch(signingIn: Bool) async throws -> ALTAnisetteData
+    {
+        let binding = self.binding
+        let clientInfo: String
+        let userAgent: String
+        var machine = self.storedMachine()
+
+        if !signingIn, let binding
+        {
+            // Apple's token works only with the machine and the identity
+            // it was made with.
+            clientInfo = binding.clientInfo
+            userAgent = binding.userAgent
+        }
+        else
+        {
+            clientInfo = AppConstants.Anisette.Cartouche.clientInfo
+            userAgent = AppConstants.Anisette.Cartouche.userAgent
+            let keepsMachine = binding.map { $0.clientInfo == clientInfo && $0.userAgent == userAgent && !$0.refused } ?? false
+            if !keepsMachine
+            {
+                debugLog("[CartoucheAnisette] Making a new machine for this sign-in.")
+                machine = nil
+            }
+        }
+
+        var lastError: Error?
+        for server in self.servers(after: binding, signingIn: signingIn)
+        {
+            // A server may tell to make a new machine when it made the one
+            // there, or when that one is being replaced anyway.
+            let mayReprovision = signingIn || machine == nil || binding?.server == server.absoluteString
+            do
+            {
+                return try await self.fetch(from: server, machine: machine, clientInfo: clientInfo, userAgent: userAgent, mayReprovision: mayReprovision)
+            }
+            catch
+            {
+                lastError = error
+                debugLog("[CartoucheAnisette] \(server.absoluteString) failed: \(error)")
+            }
+        }
+        throw lastError ?? SideSign.AnisetteError.allServersFailed
+    }
+
+    /// After a sign-in Apple refused for something else than the account
+    /// (its password, its code, too many attempts): the next one makes a new
+    /// machine, with the next server.
+    static func signInFailed(with error: Error)
+    {
+        guard var binding = self.binding, self.isRefusal(error) else { return }
+        debugLog("[CartoucheAnisette] Apple refused the sign-in: the next one makes a new machine.")
+        binding.refused = true
+        self.binding = binding
+    }
+
+    // MARK: - Servers
+
+    /// The Cartouche Installer's servers, starting with the one that last
+    /// worked, or with the next one when Apple refused that sign-in.
+    private static func servers(after binding: Binding?, signingIn: Bool) -> [URL]
+    {
+        let servers = AppConstants.Anisette.Cartouche.servers.compactMap { URL(string: $0) }
+        guard let binding, let index = servers.firstIndex(where: { $0.absoluteString == binding.server }) else {
+            return servers
+        }
+        let start = signingIn && binding.refused ? (index + 1) % servers.count : index
+        return Array(servers[start...] + servers[..<start])
+    }
+
+    private static func fetch(from server: URL, machine: Machine?, clientInfo: String, userAgent: String, mayReprovision: Bool) async throws -> ALTAnisetteData
+    {
+        if let machine
+        {
+            do
+            {
+                let (data, _) = try await self.anisette(from: server, identifier: machine.identifier, adiPb: machine.adiPb, clientInfo: clientInfo, userAgent: userAgent)
+                self.binding = Binding(version: self.version, server: server.absoluteString, clientInfo: clientInfo, userAgent: userAgent, refused: self.binding?.refused ?? false)
+                return data
+            }
+            catch SideSign.AnisetteError.badServerResponse(let status, let message) where status == -1 && mayReprovision
+            {
+                // The server's GetHeadersError: it refuses this machine.
+                debugLog("[CartoucheAnisette] \(server.absoluteString) refuses this machine (\(message)): making a new one.")
+            }
+        }
+
+        let identifier = UUID()
+        let (data, adiPb) = try await self.anisette(from: server, identifier: identifier, adiPb: nil, clientInfo: clientInfo, userAgent: userAgent)
+        guard let adiPb, !adiPb.isEmpty else {
+            throw SideSign.AnisetteError.invalidAnisetteData
+        }
+        Keychain.shared.identifier = identifier.uuidString
+        Keychain.shared.adiPb = adiPb.base64EncodedString()
+        self.binding = Binding(version: self.version, server: server.absoluteString, clientInfo: clientInfo, userAgent: userAgent, refused: false)
+        debugLog("[CartoucheAnisette] Made a new machine with \(server.absoluteString).")
+        return data
+    }
+
+    private static func anisette(from server: URL, identifier: UUID, adiPb: Data?, clientInfo: String, userAgent: String) async throws -> (data: ALTAnisetteData, newAdiBlob: Data?)
+    {
+        try await SideSign.AnisetteDataManager.shared.fetchStrictRemoteAnisetteData(
+            server: server,
+            identifier: identifier,
+            existingAdiBlob: adiPb,
+            clientInfo: clientInfo,
+            userAgent: userAgent,
+            localUserID: self.localUserID(for: identifier)
+        )
+    }
+
+    // MARK: - Machine
+
+    private static func storedMachine() -> Machine?
+    {
+        guard let text = Keychain.shared.identifier, let identifier = UUID(uuidString: text),
+              let adiPb = Keychain.shared.adiPb.flatMap({ Data(base64Encoded: $0) }), !adiPb.isEmpty
+        else { return nil }
+        return Machine(identifier: identifier, adiPb: adiPb)
+    }
+
+    /// The local user, as the Cartouche Installer names it: the SHA-256 of
+    /// the identifier's bytes, in hexadecimal.
+    private static func localUserID(for identifier: UUID) -> String
+    {
+        var uuid = identifier.uuid
+        let bytes = withUnsafeBytes(of: &uuid) { Data($0) }
+        return SHA256.hash(data: bytes).map { String(format: "%02x", $0) }.joined()
+    }
+
+    // MARK: - Errors
+
+    /// Whether Apple refused the sign-in for something else than the
+    /// account: a code of its own other than too many attempts, or a page
+    /// instead of an answer.
+    private static func isRefusal(_ error: Error) -> Bool
+    {
+        switch error
+        {
+        case ServerError.underlyingError(let code, _):
+            return ![
+                GrandSlamAuthErrorCodes.tooManyAttempts,
+                GrandSlamAuthErrorCodes.tooManyCodesRequested,
+                GrandSlamAuthErrorCodes.rateLimited,
+            ].contains(code)
+        case ServerError.invalidResponseFormat:
+            return true
+        default:
+            return false
+        }
+    }
+}
