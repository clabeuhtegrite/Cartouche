diff --git a/SideStore/Intents/CartoucheRegisterDeviceIntent.swift b/SideStore/Intents/CartoucheRegisterDeviceIntent.swift
new file mode 100644
index 0000000..f31d771
--- /dev/null
+++ b/SideStore/Intents/CartoucheRegisterDeviceIntent.swift
@@ -0,0 +1,78 @@
+//
+//  CartoucheRegisterDeviceIntent.swift
+//  SideStore
+//
+//  Cartouche: registers this iPhone with the team SideStore is signed in
+//  to, as the sign-in's device step does, and nothing else. A sign-in that
+//  Apple accepted can still stop at that step, LocalDevVPN being off or the
+//  iPhone not answering through it: SideStore then keeps the account, its
+//  session, the team and the certificate, as after its own sign-in, whose
+//  settings list Register Device among the actions left. Cartouche runs
+//  this action then, rather than signing in again, which would cost the
+//  player another verification code and Apple one more sign-in, which it
+//  limits: it goes with the session SideStore keeps, and Apple asks for no
+//  code. It runs as Sign In to Cartouche does, through LiveContainer's
+//  SideStoreSupport, in LiveProcess; Shortcuts does not list it.
+//
+//  It leaves Cartouche how it ended (CartoucheOutcome, action device), at
+//  one of these stages: account when SideStore keeps no session or team,
+//  for Cartouche to sign in again, deviceCheck when this iPhone did not
+//  answer (CartoucheDeviceCheck), device when Apple's developer services
+//  did not register it, finish once done.
+//
+
+import AppIntents
+import Foundation
+import SideSign
+
+@available(iOS 17.0, tvOS 17.0, *)
+struct CartoucheRegisterDeviceIntent: AppIntent, ProgressReportingIntent
+{
+    static var title: LocalizedStringResource = "Register Cartouche's iPhone"
+    static var description = IntentDescription("Registers this iPhone with the Apple ID that SideStore is signed in to, for Cartouche.")
+    static var openAppWhenRun = false
+    static var isDiscoverable: Bool { false }
+
+    init()
+    {
+        self.progress.completedUnitCount = 0
+        self.progress.totalUnitCount = 100
+    }
+
+    func perform() async throws -> some IntentResult
+    {
+        let outcome = CartoucheOutcome(action: .device)
+        var stage = "database"
+
+        do
+        {
+            try await DatabaseManager.shared.start()
+
+            // What the sign-in kept: without it, the whole sign-in is left.
+            stage = "account"
+            guard AuthManager.shared.adsid != nil, AuthManager.shared.hasStoredXcodeToken else {
+                throw OperationError.notAuthenticated
+            }
+            let team = try await AuthManager.shared.getAuthenticatedTeam()
+            self.progress.completedUnitCount = 10
+
+            stage = "deviceCheck"
+            try await CartoucheDeviceCheck.run()
+            self.progress.completedUnitCount = 40
+
+            stage = "device"
+            try await DeviceRegistrationFlow().registerCurrentDevice(for: team)
+
+            // As at the end of Sign In to Cartouche.
+            UserDefaults.standard.hasCompletedOnboarding = true
+            self.progress.completedUnitCount = 100
+            outcome.save(error: nil, stage: "finish", progress: self.progress)
+            return .result()
+        }
+        catch
+        {
+            outcome.save(error: error, stage: stage, progress: self.progress)
+            throw IntentError(error)
+        }
+    }
+}
