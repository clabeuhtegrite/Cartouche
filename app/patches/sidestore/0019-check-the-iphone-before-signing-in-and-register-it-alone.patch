diff --git a/SideStore/Intents/CartoucheDeviceCheck.swift b/SideStore/Intents/CartoucheDeviceCheck.swift
new file mode 100644
index 0000000..5feb56c
--- /dev/null
+++ b/SideStore/Intents/CartoucheDeviceCheck.swift
@@ -0,0 +1,68 @@
+//
+//  CartoucheDeviceCheck.swift
+//  SideStore
+//
+//  Cartouche: whether this iPhone is ready for what the built-in SideStore
+//  does through it, as each renewal and update needs it: a pairing file
+//  loaded that the iPhone accepts, Wi-Fi, LocalDevVPN connected and carrying
+//  the iPhone's own traffic, and the iPhone answering through it. It is the
+//  readiness check of minimuxer that every pipeline makes before it starts
+//  (PipelineRunner), and the one the sign-in's device step makes before it
+//  registers the iPhone.
+//
+//  Sign In to Cartouche makes it before it sends anything to Apple: a
+//  sign-in that Apple accepts and that then stops at the device step costs
+//  the player a verification code, and Apple one more sign-in, which it
+//  limits. Register Cartouche's iPhone makes it again before it registers
+//  the iPhone alone, once Apple has accepted the account.
+//
+
+import Foundation
+import Minimuxer
+
+enum CartoucheDeviceCheck
+{
+    /// How long the check waits for minimuxer: SideStore starts it as it
+    /// launches (AppBootManager), while the action may already be running.
+    static let startTimeout: TimeInterval = 15
+
+    /// Throws the error that keeps this iPhone from being reached, as
+    /// SideStore's operations would: noVPN, noConnection (no Wi-Fi), noDevice,
+    /// invalidPairingFile...
+    static func run() async throws
+    {
+        #if targetEnvironment(simulator)
+        return
+        #else
+        guard PairingFileManager.shared.fetchPairingFile() != nil else {
+            throw OperationError.pairingNotComplete(reason: "No pairing file has been loaded")
+        }
+
+        let deadline = Date().addingTimeInterval(self.startTimeout)
+        while true
+        {
+            do
+            {
+                try await ensureMinimuxerReady()
+                return
+            }
+            catch let error where self.isStarting(error) && Date() < deadline
+            {
+                try await Task.sleep(nanoseconds: 500_000_000)
+            }
+        }
+        #endif
+    }
+
+    /// Whether ERROR only says that minimuxer has not started yet, or not
+    /// read the pairing file yet, as it does for a moment after launch.
+    private static func isStarting(_ error: Error) -> Bool
+    {
+        guard let error = error as? OperationError else { return false }
+        switch error
+        {
+        case .minimuxerNotStarted, .pairingNotComplete: return true
+        default: return false
+        }
+    }
+}
