@@ -90,7 +90,26 @@ class URLHandler {
                 ExportCertificateDialog.present(callbackTemplate: callbackTemplate)
             }
             return true
-            
+
+        // Answers of another SideStore to ImportFromSideStore's requests.
+        case "importcertificate":
+            let queryItems = components.queryItems?.reduce(into: [String: String]()) { $0[$1.name.lowercased()] = $1.value } ?? [:]
+            guard let certificate = queryItems["cert"] else { return false }
+
+            Task {
+                ImportFromSideStore.importCertificate(base64: certificate, password: queryItems["password"])
+            }
+            return true
+
+        case "pairingfile":
+            let queryItems = components.queryItems?.reduce(into: [String: String]()) { $0[$1.name.lowercased()] = $1.value } ?? [:]
+            guard let pairingFile = queryItems["data"] else { return false }
+
+            Task {
+                ImportFromSideStore.importPairingFile(base64: pairingFile)
+            }
+            return true
+
         default:
             return false
         }
