--- /dev/null
+++ b/SideStore/DeepLinks/ImportFromSideStore.swift
@@ -0,0 +1,188 @@
+//
+//  ImportFromSideStore.swift
+//  SideStore
+//
+//  Imports the signing certificate and the pairing file of another SideStore
+//  on the same iPhone, such as the one inside a LiveContainer+SideStore, with
+//  the deep links that SideStore already answers: sidestore://certificate
+//  (ExportCertificateDialog) and sidestore://pairing (ExportPairingFileHandler).
+//  The answers come back to this app's own SideStore URL scheme, as
+//  importcertificate and pairingfile (see URLHandler).
+//
+//  Reusing the certificate the account already uses means this SideStore never
+//  has to create one, or revoke the one that signs the player's other apps.
+//
+
+import UIKit
+import CodeSignKit
+import MinimuxerCommon
+import SideSign
+
+@MainActor
+enum ImportFromSideStore {
+
+    /// Posted after a certificate or a pairing file has been imported.
+    static let didImport = Notification.Name("ImportFromSideStoreDidImport")
+
+    /// The scheme another SideStore answers.
+    static let otherStoreScheme = "sidestore"
+
+    /// This app's own SideStore URL scheme: the URL type that LiveContainer's
+    /// packaging names "<bundle identifier>.sidestoreurlscheme".
+    static var ownScheme: String? {
+        let urlTypes = Bundle.Info.activeBundle.object(forInfoDictionaryKey: Bundle.Info.urlTypes) as? [[String: Any]] ?? []
+        for urlType in urlTypes {
+            guard let name = urlType["CFBundleURLName"] as? String, name.hasSuffix(".sidestoreurlscheme"),
+                  let scheme = (urlType["CFBundleURLSchemes"] as? [String])?.first else { continue }
+            return scheme
+        }
+        return nil
+    }
+
+    /// Importing needs a scheme of our own: a SideStore that answers
+    /// "sidestore" itself would only be talking to itself.
+    static var isAvailable: Bool {
+        guard let ownScheme else { return false }
+        return ownScheme.lowercased() != otherStoreScheme
+    }
+
+    // MARK: - Requests
+
+    /// Asks the other SideStore for its certificate. It asks the player to confirm the export.
+    static func requestCertificate() {
+        guard isAvailable, let ownScheme else { return }
+        let callback = "\(ownScheme)://importcertificate?cert=$(BASE64_CERT)&password=$(PASSWORD)"
+        open("\(otherStoreScheme)://certificate?callback_template=\(encoded(callback))")
+    }
+
+    /// Asks the other SideStore for its pairing file.
+    static func requestPairingFile() {
+        guard isAvailable, let ownScheme else { return }
+        open("\(otherStoreScheme)://pairing?urlname=\(encoded(ownScheme))")
+    }
+
+    // MARK: - Answers
+
+    /// sidestore.<scheme>://importcertificate?cert=<base64 PKCS#12>&password=<password>
+    static func importCertificate(base64: String, password: String?) {
+        guard let data = Data(base64Encoded: base64) else {
+            toast(NSLocalizedString("The certificate could not be read.", comment: ""))
+            return
+        }
+
+        let certificate: ALTCertificate
+        do {
+            certificate = try CertificateManager.parse(data, password: password)
+        } catch {
+            toast(NSLocalizedString("The certificate could not be read.", comment: ""), detail: error.localizedDescription)
+            return
+        }
+
+        guard !certificate.privateKey.isEmpty else {
+            toast(NSLocalizedString("The certificate has no private key.", comment: ""))
+            return
+        }
+
+        // Only the certificate of the team this app is signed with can sign it again.
+        if let teamIdentifier = ownTeamIdentifier, let der = certificate.data,
+           !parseCertificate(derData: der).subject.contains(teamIdentifier) {
+            toast(NSLocalizedString("This certificate belongs to another Apple account.", comment: ""))
+            return
+        }
+
+        let expiry = DateFormatter.localizedString(from: certificate.x509.expiryDate, dateStyle: .medium, timeStyle: .none)
+        let message = String(
+            format: NSLocalizedString("SideStore will sign with “%@” (serial %@, valid until %@), the certificate the other SideStore uses. Nothing is created or revoked.", comment: ""),
+            certificate.machineName ?? certificate.name, certificate.serialNumber, expiry
+        )
+        confirm(title: NSLocalizedString("Use This Certificate?", comment: ""), message: message) {
+            do {
+                try CertificateManager.shared.setActiveCertificate(certificate)
+                NotificationCenter.default.post(name: didImport, object: nil)
+                toast(NSLocalizedString("Certificate imported", comment: ""))
+            } catch {
+                toast(NSLocalizedString("The certificate could not be saved.", comment: ""), detail: error.localizedDescription)
+            }
+        }
+    }
+
+    /// sidestore.<scheme>://pairingFile?data=<base64 pairing file>
+    static func importPairingFile(base64: String) {
+        guard let data = Data(base64Encoded: base64),
+              let contents = String(data: data, encoding: .utf8) ?? String(data: data, encoding: .isoLatin1) else {
+            toast(NSLocalizedString("The pairing file could not be read.", comment: ""))
+            return
+        }
+
+        let pairingFile: any PairingFile
+        do {
+            pairingFile = try PairingFileManager.shared.parse(content: contents)
+        } catch {
+            toast(NSLocalizedString("The pairing file could not be read.", comment: ""), detail: error.localizedDescription)
+            return
+        }
+
+        let message = String(
+            format: NSLocalizedString("SideStore will reach this %@ with the pairing file (%@) the other SideStore uses.", comment: ""),
+            UIDevice.current.model, pairingFile.mode.rawValue
+        )
+        confirm(title: NSLocalizedString("Use This Pairing File?", comment: ""), message: message) {
+            do {
+                let saved = try PairingFileManager.shared.savePairingFile(contents: contents)
+                PairingFileManager.shared.persistedActiveProtocol = saved.mode
+                NotificationCenter.default.post(name: didImport, object: nil)
+                toast(NSLocalizedString("Pairing file imported", comment: ""))
+            } catch {
+                toast(NSLocalizedString("The pairing file could not be saved.", comment: ""), detail: error.localizedDescription)
+            }
+        }
+    }
+
+    // MARK: - Helpers
+
+    /// The team identifier in this app's own signature.
+    private static var ownTeamIdentifier: String? {
+        guard let executableURL = Bundle.Info.activeBundle.executableURL,
+              let rawEntitlements = try? MachOParser.entitlements(at: executableURL),
+              let data = rawEntitlements.data(using: .utf8),
+              let entitlements = try? PropertyListSerialization.propertyList(from: data, options: [], format: nil) as? [String: Any],
+              let teamIdentifier = entitlements["com.apple.developer.team-identifier"] as? String,
+              !teamIdentifier.isEmpty else {
+            return nil
+        }
+        return teamIdentifier
+    }
+
+    /// A query value with everything but RFC 3986's unreserved characters escaped.
+    private static func encoded(_ value: String) -> String {
+        var unreserved = CharacterSet.alphanumerics
+        unreserved.insert(charactersIn: "-._~")
+        return value.addingPercentEncoding(withAllowedCharacters: unreserved) ?? value
+    }
+
+    private static func open(_ urlString: String) {
+        guard let url = URL(string: urlString) else { return }
+        UIApplication.shared.open(url, options: [:]) { opened in
+            guard !opened else { return }
+            Task { @MainActor in
+                toast(NSLocalizedString("No other SideStore answered.", comment: ""),
+                      detail: NSLocalizedString("Install the other SideStore or LiveContainer+SideStore on this iPhone, or import the files instead.", comment: ""))
+            }
+        }
+    }
+
+    private static func confirm(title: String, message: String, onConfirm: @escaping @MainActor () -> Void) {
+        guard let presenter = UIApplication.shared.topViewController() else { return }
+        let alert = UIAlertController(title: title, message: message, preferredStyle: .alert)
+        alert.addAction(UIAlertAction(title: NSLocalizedString("Use", comment: ""), style: .default) { _ in
+            onConfirm()
+        })
+        alert.addAction(UIAlertAction(title: NSLocalizedString("Cancel", comment: ""), style: .cancel))
+        presenter.present(alert, animated: true)
+    }
+
+    private static func toast(_ text: String, detail: String? = nil) {
+        guard let presenter = UIApplication.shared.topViewController() else { return }
+        ToastView(text: text, detailText: detail).show(in: presenter)
+    }
+}
