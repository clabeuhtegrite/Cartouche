diff --git a/SideStore/Intents/CartoucheOutcome.swift b/SideStore/Intents/CartoucheOutcome.swift
new file mode 100644
index 0000000..16c14a2
--- /dev/null
+++ b/SideStore/Intents/CartoucheOutcome.swift
@@ -0,0 +1,333 @@
+//
+//  CartoucheOutcome.swift
+//  SideStore
+//
+//  Cartouche: how the last of Cartouche's actions (Sign In to Cartouche,
+//  Refresh All Apps, Update Cartouche) ended. LiveContainer passes back to
+//  Cartouche only the text of an action's error, which Cartouche shows the
+//  player and never sends anywhere. This leaves Cartouche, in SideStore's
+//  keychain item cartouche.outcome (service: the bundle identifier, as in
+//  CartoucheSignInIntent), the step the action reached, how far it got,
+//  how long it took and its error as names and numbers, for Cartouche's
+//  measurements to say why actions fail:
+//
+//  {"version": 1, "action": "signIn" | "refresh" | "update", "ok": false,
+//   "date": 1762880000, "seconds": 12, "percent": 50, "stage": "device",
+//   "trail": "SignIn", "family": "minimuxer", "kind": "noVPN",
+//   "codes": "Minimuxer.MinimuxerError 3", "apple": -22406, "http": 503,
+//   "network": -1009, "host": "apple", "codeAsked": true,
+//   "codeMode": "trustedDevice", "certificates": 1, "bundledCertificate": true,
+//   "activeCertificate": false, "teams": 2, "teamType": "free"}
+//
+//  Never the error's words, an Apple ID, a team, a device, a certificate's
+//  serial, a path or an address: only the names below, chosen here, those
+//  of SideStore's error cases and operations, and numbers. Cartouche checks
+//  each value again before it keeps any.
+//
+
+import Foundation
+import Minimuxer
+import MinimuxerCommon
+import Security
+import SideSign
+
+final class CartoucheOutcome: @unchecked Sendable
+{
+    enum Action: String
+    {
+        case signIn
+        case refresh
+        case update
+    }
+
+    static let account = "cartouche.outcome"
+    static let version = 1
+
+    // MARK: - Trail
+
+    private static let trailLock = NSLock()
+    private static var trail: [String] = []
+
+    /// Notes that an operation started (BaseOperation's precondition check):
+    /// the operations an action ran, in order, end with the one it stopped in.
+    static func reached(_ operation: String)
+    {
+        var name = operation
+        if name.hasSuffix("Operation"), name.count > "Operation".count
+        {
+            name.removeLast("Operation".count)
+        }
+        self.trailLock.lock()
+        defer { self.trailLock.unlock() }
+        if self.trail.last != name
+        {
+            self.trail.append(name)
+        }
+        if self.trail.count > 12
+        {
+            self.trail.removeFirst(self.trail.count - 12)
+        }
+    }
+
+    private static func takeTrail() -> [String]
+    {
+        self.trailLock.lock()
+        defer { self.trailLock.unlock() }
+        return self.trail
+    }
+
+    // MARK: - Outcome
+
+    let action: Action
+    private let start = Date()
+    private let lock = NSLock()
+    private var facts: [String: Any] = [:]
+
+    init(action: Action)
+    {
+        self.action = action
+        Self.trailLock.lock()
+        Self.trail = []
+        Self.trailLock.unlock()
+        Self.delete()
+    }
+
+    /// Something the action learnt on its way: a name or a number.
+    func note(_ key: String, _ value: Any)
+    {
+        self.lock.lock()
+        self.facts[key] = value
+        self.lock.unlock()
+    }
+
+    /// Leaves Cartouche how the action ended: with ERROR, or well when nil.
+    /// STAGE, when the action knows it, is the step it reached; otherwise
+    /// the last operation it started.
+    func save(error: Error?, stage: String? = nil, progress: Progress? = nil)
+    {
+        var outcome: [String: Any] = [
+            "version": Self.version,
+            "action": self.action.rawValue,
+            "ok": error == nil,
+            "date": Int(Date().timeIntervalSince1970),
+            "seconds": max(0, Int(Date().timeIntervalSince(self.start).rounded())),
+        ]
+
+        let trail = Self.takeTrail()
+        if !trail.isEmpty
+        {
+            outcome["trail"] = trail.suffix(5).joined(separator: ">")
+        }
+        if let stage = stage ?? trail.last
+        {
+            outcome["stage"] = stage
+        }
+        if let progress, progress.totalUnitCount > 0
+        {
+            let fraction = min(max(progress.fractionCompleted, 0), 1)
+            outcome["percent"] = Int((fraction * 100).rounded())
+        }
+
+        self.lock.lock()
+        for (key, value) in self.facts
+        {
+            outcome[key] = value
+        }
+        self.lock.unlock()
+
+        if let error
+        {
+            let (family, kind) = Self.kind(of: error)
+            outcome["family"] = family
+            outcome["kind"] = kind
+            outcome["codes"] = Self.codes(of: error)
+            if let apple = Self.appleCode(of: error)
+            {
+                outcome["apple"] = apple
+            }
+            if let status = Self.httpStatus(of: error)
+            {
+                outcome["http"] = status
+            }
+            if let (code, host) = Self.network(of: error)
+            {
+                outcome["network"] = code
+                outcome["host"] = host
+            }
+        }
+
+        guard let data = try? JSONSerialization.data(withJSONObject: outcome) else { return }
+        Self.write(data)
+    }
+
+    // MARK: - Errors, as names and numbers
+
+    /// The family of an error (whose it is) and its kind (its case).
+    static func kind(of error: Error) -> (family: String, kind: String)
+    {
+        if let error = error as? CartoucheSignInError
+        {
+            return ("cartouche", error.kind.rawValue)
+        }
+
+        let family: String
+        switch error
+        {
+        case is DeveloperPortalError: family = "portal"
+        case is ServerError: family = "server"
+        case is AnisetteError: family = "anisette"
+        case is OperationError: family = "operation"
+        case is MinimuxerError: family = "minimuxer"
+        case is PairingError: family = "pairing"
+        case is EMProxyError: family = "emProxy"
+        case is SignerError: family = "signer"
+        case is CertificateError: family = "certificate"
+        case is OCSPValidationError: family = "ocsp"
+        case is DatabaseError: family = "database"
+        case is DecodingError: family = "decoding"
+        case is CancellationError: return ("cancelled", "cancelled")
+        default:
+            let nsError = error as NSError
+            switch nsError.domain
+            {
+            case NSURLErrorDomain: return ("network", "url")
+            case NSCocoaErrorDomain: return ("cocoa", "cocoa")
+            case NSPOSIXErrorDomain: return ("posix", "posix")
+            case NSOSStatusErrorDomain: return ("system", "osStatus")
+            default: return ("other", self.name(String(describing: type(of: error))) ?? "unnamed")
+            }
+        }
+        return (family, self.caseName(of: error))
+    }
+
+    /// The name of an enumeration's case, without what it carries.
+    static func caseName(of value: Any) -> String
+    {
+        let mirror = Mirror(reflecting: value)
+        guard mirror.displayStyle == .enum else {
+            return self.name(String(describing: type(of: value))) ?? "unnamed"
+        }
+        // A case that carries values is the label of what it carries; one
+        // that carries none prints as its name, unless its type prints
+        // itself otherwise, which the check below leaves out.
+        if let label = mirror.children.first?.label
+        {
+            return self.name(label) ?? "unnamed"
+        }
+        return self.name(String(describing: value)) ?? "unnamed"
+    }
+
+    /// NAME when it is a name a programmer gave, nothing else.
+    static func name(_ name: String) -> String?
+    {
+        guard (1...48).contains(name.count),
+              let first = name.unicodeScalars.first, CharacterSet.letters.contains(first),
+              name.unicodeScalars.allSatisfy({ $0.isASCII && (CharacterSet.alphanumerics.contains($0) || $0 == "_") })
+        else { return nil }
+        return name
+    }
+
+    /// The domain and code of the error and of those under it, up to four:
+    /// "NSURLErrorDomain -1001 < NSPOSIXErrorDomain 60".
+    static func codes(of error: Error) -> String
+    {
+        var parts: [String] = []
+        var current: NSError? = error as NSError
+        while let found = current, parts.count < 4
+        {
+            let domain = found.domain.unicodeScalars.allSatisfy({ $0.isASCII && (CharacterSet.alphanumerics.contains($0) || "._-".unicodeScalars.contains($0)) }) && found.domain.count <= 64 ? found.domain : "other"
+            parts.append("\(domain) \(found.code)")
+            current = found.userInfo[NSUnderlyingErrorKey] as? NSError
+        }
+        return parts.joined(separator: " < ")
+    }
+
+    /// Apple's own code, when Apple's servers gave one: -22406 for a wrong
+    /// password, the Developer Portal's result code...
+    static func appleCode(of error: Error) -> Int?
+    {
+        if case ServerError.underlyingError(let code, _) = error
+        {
+            return code
+        }
+        return nil
+    }
+
+    /// The HTTP status a server answered with, when the error says.
+    static func httpStatus(of error: Error) -> Int?
+    {
+        switch error
+        {
+        case AnisetteError.badServerResponse(let status, _) where (100...599).contains(status):
+            return status
+        case ServerError.badServerResponse(let reason, _):
+            // "HTTP 503 from bundleIds", "... (HTTP 502)": only the number.
+            guard let range = reason.range(of: "HTTP [1-5][0-9][0-9]", options: .regularExpression) else { return nil }
+            return Int(reason[range].dropFirst(5))
+        default:
+            return nil
+        }
+    }
+
+    /// The URL error's code and what the server it could not reach is,
+    /// as one of a few names, never its address.
+    static func network(of error: Error) -> (code: Int, host: String)?
+    {
+        var current: NSError? = error as NSError
+        var depth = 0
+        while let found = current, depth < 4
+        {
+            if found.domain == NSURLErrorDomain
+            {
+                let url = found.userInfo[NSURLErrorFailingURLErrorKey] as? URL
+                return (found.code, self.hostKind(url?.host))
+            }
+            current = found.userInfo[NSUnderlyingErrorKey] as? NSError
+            depth += 1
+        }
+        return nil
+    }
+
+    static func hostKind(_ host: String?) -> String
+    {
+        guard let host = host?.lowercased(), !host.isEmpty else { return "unknown" }
+        func within(_ domain: String) -> Bool { host == domain || host.hasSuffix("." + domain) }
+
+        if within("apple.com") || within("icloud.com") { return "apple" }
+        if within("sidestore.io") { return "sideStore" }
+        if within("github.io") || within("github.com") || within("githubusercontent.com") { return "github" }
+        if host.hasPrefix("10.7.0.") || host == "localhost" || host == "127.0.0.1" { return "device" }
+        return "other"
+    }
+
+    // MARK: - Keychain
+
+    private static var service: String { Bundle.Info.appbundleIdentifier }
+
+    private static func delete()
+    {
+        let query: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: self.service,
+            kSecAttrAccount as String: self.account,
+        ]
+        SecItemDelete(query as CFDictionary)
+    }
+
+    private static func write(_ data: Data)
+    {
+        self.delete()
+        let item: [String: Any] = [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: self.service,
+            kSecAttrAccount as String: self.account,
+            kSecAttrAccessible as String: kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly,
+            kSecValueData as String: data,
+        ]
+        let status = SecItemAdd(item as CFDictionary, nil)
+        if status != errSecSuccess
+        {
+            debugLog("[CartoucheOutcome] could not leave the outcome: \(status)")
+        }
+    }
+}
