@@ -30,6 +30,8 @@ struct UpdateCartoucheIntent: AppIntent, ProgressReportingIntent
 
     func perform() async throws -> some IntentResult
     {
+        // How it ended, for Cartouche (CartoucheOutcome).
+        let outcome = CartoucheOutcome(action: .update)
