--- a/SideStore/Core/Auth/DeveloperPortalProxy.swift
+++ b/SideStore/Core/Auth/DeveloperPortalProxy.swift
@@ -118,6 +118,13 @@ public class DeveloperPortalProxy {
         return try await ALTAppleAPI.shared.updateAppID(appID, team: team, session: session)
     }
 
+    /// Enables capabilities on an App ID through the developer services v1 API.
+    public func enableCapabilities(_ capabilities: [String], for appID: ALTAppID, team: ALTTeam? = nil) async throws {
+        let session = try await self.getSession()
+        let team = try await self.getTeam(team)
+        try await ALTAppleAPI.shared.enableCapabilities(capabilities, for: appID, team: team, session: session)
+    }
+
     @discardableResult
     public func deleteAppID(_ appID: ALTAppID, team: ALTTeam? = nil) async throws -> Bool {
         let session = try await self.getSession()
diff --git a/SideStore/Core/Operations/PipelineOperations/FetchProvisioningProfilesOperation.swift b/SideStore/Core/Operations/PipelineOperations/FetchProvisioningProfilesOperation.swift
index e0e2399..f0f5e33 100644
--- a/SideStore/Core/Operations/PipelineOperations/FetchProvisioningProfilesOperation.swift
+++ b/SideStore/Core/Operations/PipelineOperations/FetchProvisioningProfilesOperation.swift
@@ -183,6 +183,8 @@ class FetchProvisioningProfilesOperation: BasePipelineOperation<InstallAppOperat
         self.debugLog("[FetchProvisioningProfiles] Updating app groups for App ID \(updatedAppID.bundleIdentifier)...")
         let groupAppID = try await self.updateAppGroups(for: updatedAppID, targetAppBundle: targetAppBundle, team: team)
         
+        await self.enableIncreasedMemoryLimitIfRequested(for: groupAppID, targetAppBundle: targetAppBundle, team: team)
+        
         verboseLog(targetAppBundle.dumpMachOInfo())
         self.debugLog("[FetchProvisioningProfiles] Fetching provisioning profile from Apple for App ID \(groupAppID.bundleIdentifier)...")
         let profile = try await DeveloperPortalProxy.shared.downloadProvisioningProfile(for: groupAppID, deviceType: DeveloperPortalProxy.currentDeviceType, team: team)
@@ -299,6 +301,34 @@ private extension FetchProvisioningProfilesOperation{
         }
     }
     
+    /// Enables Increased Memory Limit on a free team's App ID when the app asks for it,
+    /// or SideStore's additional entitlements add it, as they do for every app.
+    ///
+    /// updateFeatures drops the capability for free teams, because updateAppId.action
+    /// cannot enable it for them, while the v1 API can (SideStore#1616). A failure
+    /// is logged and the app is still installed, with the default memory limit.
+    func enableIncreasedMemoryLimitIfRequested(for appID: ALTAppID, targetAppBundle: ALTApplication, team: ALTTeam) async {
+        guard team.type == .free else { return }
+
+        let bundleID = targetAppBundle.bundleIdentifier
+        var entitlements = self.context.customEntitlementsByBundleID[bundleID]
+            ?? targetAppBundle.entitlements
+        for (key, value) in self.context.additionalEntitlements {
+            entitlements[key] = value
+        }
+        // The additional entitlements give the key the entitlement itself for a value,
+        // never true: any value but false asks for it, as updateFeatures reads them.
+        guard let requested = entitlements[ALTEntitlement.increasedMemoryLimit.rawValue],
+              (requested as? Bool) != false else { return }
+
+        do {
+            try await DeveloperPortalProxy.shared.enableCapabilities([BundleIDCapability.increasedMemoryLimit], for: appID, team: team)
+            self.debugLog("[FetchProvisioningProfiles] Enabled Increased Memory Limit on App ID \(appID.bundleIdentifier).")
+        } catch {
+            self.debugLog("[FetchProvisioningProfiles] Could not enable Increased Memory Limit on App ID \(appID.bundleIdentifier): \(error.localizedDescription)")
+        }
+    }
+
     func updateAppGroups(for appID: ALTAppID, targetAppBundle: ALTApplication, team: ALTTeam) async throws -> ALTAppID {
         let bundleID = targetAppBundle.bundleIdentifier
         var entitlements = self.context.customEntitlementsByBundleID[bundleID]
