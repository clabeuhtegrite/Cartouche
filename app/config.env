# Settings shared by the app build scripts and the server tools.
# The publish guard (server/cartouche_server/__init__.py) must use the same bundle identifier.
CARTOUCHE_BUNDLE_ID=io.github.clabeuhtegrite.cartouche
CARTOUCHE_DISPLAY_NAME=Cartouche

# Cartouche's own names in the LiveContainer and SideStore sources, applied by
# app/scripts/brand.py. The app group is "group." plus the bundle identifier,
# and the built-in SideStore answers "sidestore." plus the URL scheme.
CARTOUCHE_URL_SCHEME=cartouche
# The source the built-in SideStore reads: Cartouche itself, and nothing else.
CARTOUCHE_SIDESTORE_SOURCE_URL=https://raw.githubusercontent.com/clabeuhtegrite/Cartouche/main/app/sidestore-source.json
